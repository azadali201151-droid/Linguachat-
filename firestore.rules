rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'subscriptionStatus', 'trialUsedSeconds']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.subscriptionStatus is string && data.subscriptionStatus.size() <= 20 &&
             data.trialUsedSeconds is number &&
             (data.get('planEndTimestamp', null) == null || data.get('planEndTimestamp', null) is number) &&
             (data.get('planId', null) == null || data.get('planId', null) is string) &&
             (data.get('planRegion', null) == null || data.get('planRegion', null) is string) &&
             data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['trialUsedSeconds'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['subscriptionStatus', 'planEndTimestamp', 'planId', 'planRegion', 'trialUsedSeconds']))
      );
    }
  }
}
